RENTRI_ENV=prod
RENTRI_P12_PATH=./certificati/interoperabilita_produzione.p12
RENTRI_P12_PASSWORD=
RENTRI_IDENTIFICATIVO=
# Denominazione operatore per il filtro Da firmare
RENTRI_RAGIONE_SOCIALE=TRUCCOLO ANGELO SRL
RENTRI_NUM_ISCR_SITO=
RENTRI_CA_CREDENTIALS_ID=
RENTRI_GESTIONALE_USER_ID=

# Display QR su tablet Android nella rete locale
# IP del PC CENTRALE: è il PC che resta acceso e sul quale è aperto BOOMER
RENTRI_TABLET_PC_IP=192.168.1.70
# IP del tablet Android che visualizza il QR (un solo tablet autorizzato)
RENTRI_TABLET_IP=192.168.1.11
RENTRI_TABLET_PORT=8766
# IP dei PC autorizzati a INVIARE QR al PC centrale, separati da virgola
# Esempio: PC centrale .70 + altri PC ufficio .71 e .72
RENTRI_TABLET_SENDER_IPS=192.168.1.70,192.168.1.71,192.168.1.72
